# Non-secret host-specific paths/topology. Live values belong outside Git at:
# ~/.config/homeserver/runtime.env
HOMESERVER_RUNTIME_ROOT=/srv/homeserver/runtime
HOMESERVER_PRIVATE_CONFIG_ROOT=/etc/homeserver
HOMESERVER_DOCKER_NETWORK=homeserver
STORAGE_ROOT=/srv/homeserver/storage
TZ=Etc/UTC
LAN_INTERFACE=eth0
LAN_MAC=00:11:22:33:44:55
LAN_CIDR=192.0.2.0/24
WIREGUARD_INTERFACE=wg-home
HOME_TUNNEL_IP=10.10.0.2
VPS_TUNNEL_IP=10.10.0.1
PUBLIC_BASE_DOMAIN=example.com
VPS_PUBLIC_IP=203.0.113.10
VPS_SSH_TARGET=ubuntu@203.0.113.10
JELLYFIN_HOSTNAME=jellyfin.example.com
SEERR_HOSTNAME=seerr.example.com
HOMEASSISTANT_HOSTNAME=homeassistant.example.com
NEXTCLOUD_HOSTNAME=nextcloud.example.com
